DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_checklist

# VAPID keys for Web Push (npx web-push generate-vapid-keys)
NUXT_PUSH_VAPID_PUBLIC_KEY=
NUXT_PUSH_VAPID_PRIVATE_KEY=
NUXT_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Enable push scheduler in dev (disabled by default)
# ENABLE_PUSH_SCHEDULER=true
